# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://attendance_user:attendance_pass@localhost:5432/attendance_db
DATABASE_URL_SYNC=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db

# ── Auth — generate a strong key with: openssl rand -hex 32 ──────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS (add your frontend URL here) ─────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── File storage ───────────────────────────────────────────────────────────────
EMBEDDINGS_DIR=data/embeddings
FACE_PHOTOS_DIR=data/face_photos
SNAPSHOTS_DIR=data/snapshots

# ── Face recognition ───────────────────────────────────────────────────────────
RECOGNITION_THRESHOLD=0.75
YOLO_MODEL_PATH=data/models/yolov8n-face.pt
MIN_FACE_SIZE=40

# ── Dev flags ─────────────────────────────────────────────────────────────────
DEBUG=true
